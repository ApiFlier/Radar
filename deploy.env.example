# Radar deployment config
# Copy this to deploy.env and fill in the required values.
#
# setup.sh reads deploy.env, creates /opt/radar/.env, adds defaults,
# builds containers, and starts Radar.

# Optional setup behavior
INSTALL_DIR=/opt/radar
DELETE_SOURCE=ask

# Required FAA / SWIM credentials
FAA_USER=
FAA_PASS=
QUEUE_SFDPS=
QUEUE_STDDS=
QUEUE_TFMS=

# FAA default, usually leave alone
FAA_URL=tcps://ems1.swim.faa.gov:55443

# Optional OpenSky credentials
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Web UI
WEB_BIND=0.0.0.0
WEB_PORT=8080

# ADSB.lol primary air feed
# The server/public IP must have ADSB.lol feeder access for re-api.
ADSBLOL_REAPI_CIRCLES=40.491389,-80.232778,250
ADSBLOL_REAPI_INTERVAL_SECONDS=10

# Ground aircraft sweep
GROUND_SWEEP_CLUSTER_INTERVAL_SECONDS=300
