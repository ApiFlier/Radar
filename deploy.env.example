# Aviation Radar — User-supplied configuration
# Copy this file to deploy.env and fill in your values.
# setup.sh reads deploy.env and generates .env with production-ready defaults.
# Never commit deploy.env — it contains credentials.

# ── FAA SWIM Ingestor ─────────────────────────────────────────────────────────
# Set to true only if you have FAA SWIM credentials (see Data Sources in README).
# When false, the SWIM ingestor container is not started and FAA fields below
# are not required. ADS-B live tracking works without SWIM.
ENABLE_SWIM_INGESTOR=false

# Required only when ENABLE_SWIM_INGESTOR=true
FAA_USER=
FAA_PASS=
QUEUE_SFDPS=
QUEUE_STDDS=
QUEUE_TFMS=

# ── Optional Credentials ──────────────────────────────────────────────────────
# OpenSky Network API (optional — enhances coverage, not required)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# ── Resource Guardrails ───────────────────────────────────────────────────────
# Disk space warning thresholds in GB
MIN_FREE_GB_WARN=25
MIN_FREE_GB_CRITICAL=10

# Redis memory limits
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru
