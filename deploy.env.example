# Aviation Radar — User-supplied configuration
# Copy this file to deploy.env and fill in your values.
# setup.sh reads deploy.env and generates .env with production-ready defaults.
# Never commit deploy.env — it contains credentials.

# ── FAA SWIM Ingestor (Recommended) ───────────────────────────────────────────
# FAA SWIM is the recommended source for serious tracking without receiver hardware.
# To enable, simply provide your FAA SWIM credentials and queue subscriptions below.
# The app will automatically detect these credentials and enable the SWIM ingestor.

FAA_USER=
FAA_PASS=
QUEUE_SFDPS=
QUEUE_STDDS=
QUEUE_TFMS=

# ── Optional Credentials (Enhancements) ───────────────────────────────────────
# OpenSky Network API (optional — enhances coverage, not required)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# ── Resource Guardrails ───────────────────────────────────────────────────────
# Disk space warning thresholds in GB
MIN_FREE_GB_WARN=25
MIN_FREE_GB_CRITICAL=10

# Redis memory limits
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru
