# ============================================================
# Radar deployment config
# ============================================================
#
# Quick install:
#
#   git clone <private repo>
#   cd Radar
#   cp deploy.env.example deploy.env
#   nano deploy.env
#   chmod +x setup.sh
#   ./setup.sh
#
# Fill in the required FAA/SWIM values below.
# Everything else is handled by setup.sh.
#
# Credential / access links:
#
#   FAA API Portal:
#     https://portal.apic4e.faa.gov/
#
#   FAA SWIM / NAS Enterprise Messaging:
#     https://www.faa.gov/air_traffic/technology/swim
#
#   OpenSky Network, optional:
#     https://opensky-network.org/
#
#   ADSB.lol feeder / re-api docs:
#     https://www.adsb.lol/docs/
#
# ============================================================

# Required FAA / SWIM credentials
FAA_USER=
FAA_PASS=
QUEUE_SFDPS=
QUEUE_STDDS=
QUEUE_TFMS=

# Optional OpenSky credentials
# Leave blank or remove if you do not use OpenSky.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
