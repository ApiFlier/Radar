# Aviation Radar — deploy.env
# Copy: cp deploy.env.example deploy.env
# deploy.env is optional. The app runs without it using public ADS-B data only.
# Add credentials here to enable enhanced data sources.

# ── FAA SWIM credentials (optional) ──────────────────────────────────────────
# Enables the FAA SWIM ingestor (flight plan / track data).
# Add FAA_USER, FAA_PASS, and at least one QUEUE_* — SWIM starts automatically.
FAA_USER=
FAA_PASS=
QUEUE_SFDPS=
QUEUE_STDDS=
QUEUE_TFMS=

# ── OpenSky Network credentials (optional) ────────────────────────────────────
# Enables authenticated OpenSky coverage. Anonymous mode is used if absent.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

