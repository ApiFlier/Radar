# Radar runtime configuration
# Copy to .env or run: ./scripts/setup-env.sh

# FAA / SWIM credentials
FAA_USER=
FAA_PASS=
QUEUE_SFDPS=
QUEUE_STDDS=
QUEUE_TFMS=
FAA_URL=tcps://ems1.swim.faa.gov:55443

# Optional OpenSky credentials
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Web UI
# 0.0.0.0 allows LAN/proxy/tunnel access.
# 127.0.0.1 is better when your tunnel/reverse proxy runs on the same host.
WEB_BIND=0.0.0.0
WEB_PORT=8080

# Internal Docker service name
REDIS_HOST=redis
REDIS_PORT=6379

# ADSB.lol primary air feed
ADSBLOL_REAPI_URL=https://re-api.adsb.lol/
ADSBLOL_REAPI_BASE=https://re-api.adsb.lol
ADSBLOL_REAPI_CIRCLES=40.491389,-80.232778,250
ADSBLOL_REAPI_INTERVAL_SECONDS=10
ADSBLOL_REAPI_TTL_SECONDS=45
ADSBLOL_REAPI_REQUEST_SPACING_SECONDS=1.2
ADSBLOL_HEALTH_MAX_AGE_SECONDS=45

# ADSB.lol airport ground sweep
GROUND_SWEEP_CLUSTER_INTERVAL_SECONDS=300
GROUND_SWEEP_REQUEST_SPACING_SECONDS=5
GROUND_SWEEP_TTL_SECONDS=900
GROUND_SWEEP_MAX_SEEN_POS_SECONDS=120
GROUND_SWEEP_RADIUS_NM=250
